# Copy this file to .env. Never commit .env.
# Organiser console password (minimum 12 characters). Use a fresh random value for every event:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# Passwords that were ever committed to this repository are refused at sign-in.
ORGANISER_PASSWORD=replace-with-a-long-random-password

# Secret for the HMAC-protected Level 4 final-discovery answer (and the legacy app.py flow).
#   python -c "import secrets; print(secrets.token_hex(32))"
# After setting it, run `python scripts/build_challenge.py` to rebuild data/answer_key/flag_registry.json.
FLAG_HMAC_SECRET=replace-with-a-random-64-character-secret

# Optional: move runtime event data outside the repository.
# UL_EVENT_STATE=/absolute/path/to/event_state.json

# Optional novel-edge judge (off by default). See README "Novel-edge judge".
# Sign in with ChatGPT needs no key here: run `python3 scripts/chatgpt_login.py` once on each machine.
# Optional novel-edge judge and live graph verification.
# Set OPENAI_API_KEY for OpenAI Pro account (default model: gpt-4o-mini)
JUDGING_ENABLED=1
JUDGE_PROVIDER=openai             # openai | grok | anthropic | chatgpt
JUDGE_MODEL=gpt-4o-mini           # gpt-4o-mini | gpt-4o | grok-2-latest
OPENAI_API_KEY=                   # OpenAI API Key

# Alternative providers:
# XAI_API_KEY=                    # for JUDGE_PROVIDER=grok (or GROK_API_KEY)
# ANTHROPIC_API_KEY=              # only for JUDGE_PROVIDER=anthropic
