# Copy this file to .env. Never commit .env.
# Organiser console password (minimum 12 characters). Use a fresh random value for every event:
#   python -c "import secrets; print(secrets.token_urlsafe(18))"
# Passwords that were ever committed to this repository are refused at sign-in.
ORGANISER_PASSWORD=replace-with-a-long-random-password

# Secret for the HMAC-protected Level 4 final-discovery answer (and the legacy app.py flow).
#   python -c "import secrets; print(secrets.token_hex(32))"
# After setting it, run `python scripts/build_challenge.py` to rebuild data/answer_key/flag_registry.json.
FLAG_HMAC_SECRET=replace-with-a-random-64-character-secret

# Optional: move runtime event data outside the repository.
# UL_EVENT_STATE=/absolute/path/to/event_state.json
